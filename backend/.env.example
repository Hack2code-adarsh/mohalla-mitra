# Backend environment variables (copy to .env and fill in)
# Neon PostgreSQL connection string (get from your Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of allowed frontend origins
# Production: add your Vercel URL, e.g. https://mohalla-mitra.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Client ID (defaults to the demo ID if unset)
GOOGLE_CLIENT_ID=1009125264293-gh5gcga6tosa7tse5e10r27upq7eip40.apps.googleusercontent.com

# Optional: override the base URL used for uploaded image URLs
# BASE_URL=https://your-backend.onrender.com
